<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Existing tests use operation-specific cancellation and timeout sources; analyzer cleanup is tracked separately. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\GitKeyRouter.Core\GitKeyRouter.Core.csproj" />
    <ProjectReference Include="..\..\src\GitKeyRouter.Infrastructure\GitKeyRouter.Infrastructure.csproj" />
    <ProjectReference Include="..\GitKeyRouter.ProcessTestChild\GitKeyRouter.ProcessTestChild.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyProcessTestChild" AfterTargets="Build">
    <ItemGroup>
      <ProcessTestChildFiles Include="..\GitKeyRouter.ProcessTestChild\bin\$(Configuration)\net10.0\GitKeyRouter.ProcessTestChild*" />
    </ItemGroup>
    <Copy SourceFiles="@(ProcessTestChildFiles)" DestinationFolder="$(OutDir)process-test-child" />
  </Target>
</Project>
